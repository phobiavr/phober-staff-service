includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8

    paths:
        - app
        - config
        - routes
        - shared/laravel-common/src

    excludePaths:
        # Requires spatie/laravel-medialibrary, which this service doesn't use
        # at runtime (no HasMedia models here) and isn't installed for.
        - shared/laravel-common/src/Media.php

    tmpDir: build/phpstan

    treatPhpDocTypesAsCertain: false
